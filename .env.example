# Aplicação (ENVIRONMENT=prod em produção: desliga /docs e usa cookies seguros)
ENVIRONMENT=dev
DATABASE_URL=
SECRET_KEY=
CLIENT_ID=
ACCESS_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=
ALGORITHM=
FRONTEND_URL=

# Pagamento
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_ACESS_TOKEN=

# Email
SMPT_USER=
SMTP_PASSORD=
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=
SMTP_USE_TLS=
SMTP_USE_SSL=
APP_PUBLIC_URL=


# Cors
CORS_ORIGINS=http://localhost:8010,http://localhost:5173,http://localhost:5199,http://localhost:5200,http://localhost:8012

# Whatsapp
WHATSAPP_ACESS_TOKEN=
WHATSAPP_SECRET_KEY=

# Cookies de Autenticação
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=
REFRESH_TOKEN_EXPIRE_DAYS=

# Cloudflare R2 (upload de fotos do catálogo)
# Crie em https://dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nail-appointment
R2_PUBLIC_URL=
R2_MAX_IMAGE_MB=5
# Web Push / VAPID (notificações no dispositivo da admin)
# Gere com: npx -y web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@anaclaranails.com

# Seed inicial (conta admin + grade Seg–Sex). Rode UMA VEZ e remova a senha.
# O entrypoint do backend executa automaticamente se preenchidos.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Ana Clara
